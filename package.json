{
  "name": "jinglun",
  "private": true,
  "version": "0.10.0-gameplay",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:server": "node scripts/rust.mjs run -p jinglun-server",
    "build": "npm run check && vite build --config frontend/vite.config.ts",
    "build:server": "node scripts/rust.mjs build --release -p jinglun-server",
    "check": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:rust": "node scripts/rust.mjs test --workspace",
    "fmt": "node scripts/rust.mjs fmt --all",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "pixi.js": "8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
